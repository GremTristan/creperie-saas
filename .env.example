# Copiez vers .env.local :  cp .env.example .env.local

# Neon Postgres (pooled pour l’app, unpooled pour migrations / seed)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Secret HMAC des cookies de session (≥ 32 caractères aléatoires en production)
SESSION_SECRET=

# URL publique de l’app (sans slash final) — redirections Stripe, liens légaux
APP_URL=http://localhost:3000

# Fuseau pour les journées de service et rapports
APP_TIMEZONE=Europe/Zurich

# Stripe — deux prix récurrents mensuels « par établissement »
STRIPE_SECRET_KEY=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Identité de l’éditeur (mentions légales, CGU, confidentialité)
NEXT_PUBLIC_EDITOR_NAME=
NEXT_PUBLIC_EDITOR_ADDRESS=
NEXT_PUBLIC_EDITOR_EMAIL=
NEXT_PUBLIC_EDITOR_REGISTRATION=
NEXT_PUBLIC_EDITOR_HOSTING=
NEXT_PUBLIC_EDITOR_COUNTRY=Suisse

# OCR des bons de livraison (OpenAI-compatible vision). Sans clé : photo stockée, lignes saisies à la main / JSON.
OCR_API_KEY=
# OCR_API_URL=https://api.openai.com/v1/chat/completions
# OCR_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
